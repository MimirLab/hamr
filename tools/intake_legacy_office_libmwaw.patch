+void MWAWTextListener::addCoveredTableCell(MWAWVec2i const &pos)
+{
+  if (!m_ps->m_isTableRowOpened || m_ps->m_isTableCellOpened)
+    return;
+  librevenge::RVNGPropertyList props;
+  props.insert("librevenge:column", pos[0]);
+  props.insert("librevenge:row", pos[1]);
+  m_documentInterface->insertCoveredTableCell(props);
+}
